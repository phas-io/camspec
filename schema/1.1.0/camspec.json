{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "version",
        "manifest",
        "constraints",
        "globalConstraints"
    ],
    "properties": {
        "version": {
            "type": "string",
            "description": "CAMS specification version",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "manifest": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "file",
                    "units",
                    "quantity"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Unique identifier for this instance"
                    },
                    "file": {
                        "type": "string",
                        "description": "Relative path to file in models directory"
                    },
                    "format": {
                        "type": "string",
                        "enum": [
                            "STEP",
                            "STL_ASCII",
                            "STL_BINARY",
                            "OBJ",
                            "BREP",
                            "IGES"
                        ]
                    },
                    "name": {
                        "type": "string",
                        "description": "Optional human-readable name"
                    },
                    "priority": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100,
                        "description": "Priority level (0-100). Higher numbers indicate higher priority"
                    },
                    "quantity": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The number of instances of this part"
                    },
                    "units": {
                        "type": "string",
                        "enum": [
                            "MM",
                            "CM",
                            "FT",
                            "IN"
                        ],
                        "description": "Units of the original CAD file"
                    },
                    "referenceTransform": {
                        "type": "object",
                        "required": [
                            "rotation",
                            "translation"
                        ],
                        "properties": {
                            "rotation": {
                                "type": "array",
                                "items": {
                                    "type": "number"
                                },
                                "minItems": 9,
                                "maxItems": 9,
                                "description": "3x3 rotation matrix in row-major order"
                            },
                            "translation": {
                                "type": "array",
                                "items": {
                                    "type": "number"
                                },
                                "minItems": 3,
                                "maxItems": 3,
                                "description": "Translation vector [x, y, z]"
                            }
                        }
                    }
                }
            }
        },
        "constraints": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "manifestId",
                    "type",
                    "value"
                ],
                "properties": {
                    "manifestId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "FIXED_ORIENTATION",
                            "RANGE_ORIENTATION",
                            "FORBIDDEN_ORIENTATION",
                            "FIXED_LOCATION",
                            "RANGE_LOCATION",
                            "LINEAR_TOLERANCE",
                            "CIRCULARITY_TOLERANCE"
                        ]
                    },
                    "value": {
                        "oneOf": [
                            {
                                "type": "object",
                                "description": "FIXED_ORIENTATION value",
                                "required": [
                                    "rotation"
                                ],
                                "properties": {
                                    "rotation": {
                                        "type": "array",
                                        "items": {
                                            "type": "number"
                                        },
                                        "minItems": 9,
                                        "maxItems": 9,
                                        "description": "3x3 rotation matrix in row-major order"
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "description": "RANGE_ORIENTATION value",
                                "required": [
                                    "axis",
                                    "range",
                                    "units"
                                ],
                                "properties": {
                                    "axis": {
                                        "type": "array",
                                        "items": {
                                            "type": "number"
                                        },
                                        "minItems": 3,
                                        "maxItems": 3,
                                        "description": "Rotation axis vector [x, y, z]"
                                    },
                                    "range": {
                                        "type": "object",
                                        "required": [
                                            "min",
                                            "max"
                                        ],
                                        "properties": {
                                            "min": {
                                                "type": "number",
                                                "minimum": -180,
                                                "maximum": 180,
                                                "description": "Minimum rotation angle"
                                            },
                                            "max": {
                                                "type": "number",
                                                "minimum": -180,
                                                "maximum": 180,
                                                "description": "Maximum rotation angle"
                                            }
                                        }
                                    },
                                    "units": {
                                        "type": "string",
                                        "enum": [
                                            "DEG",
                                            "RAD"
                                        ]
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "description": "FORBIDDEN_ORIENTATION value",
                                "required": [
                                    "normals",
                                    "tolerance",
                                    "units"
                                ],
                                "properties": {
                                    "normals": {
                                        "type": "array",
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "type": "number"
                                            },
                                            "minItems": 3,
                                            "maxItems": 3
                                        },
                                        "description": "Array of normal vectors that cannot point downward"
                                    },
                                    "tolerance": {
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 180,
                                        "description": "Allowed deviation in degrees"
                                    },
                                    "units": {
                                        "type": "string",
                                        "enum": [
                                            "DEG",
                                            "RAD"
                                        ]
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "description": "FIXED_LOCATION value",
                                "required": [
                                    "x",
                                    "y",
                                    "z",
                                    "units"
                                ],
                                "properties": {
                                    "x": {
                                        "type": "number"
                                    },
                                    "y": {
                                        "type": "number"
                                    },
                                    "z": {
                                        "type": "number"
                                    },
                                    "units": {
                                        "type": "string",
                                        "enum": [
                                            "MM",
                                            "CM",
                                            "FT",
                                            "IN"
                                        ]
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "description": "RANGE_LOCATION value",
                                "required": [
                                    "bounds",
                                    "units"
                                ],
                                "properties": {
                                    "bounds": {
                                        "type": "object",
                                        "properties": {
                                            "x": {
                                                "type": "object",
                                                "properties": {
                                                    "min": {
                                                        "type": "number"
                                                    },
                                                    "max": {
                                                        "type": "number"
                                                    }
                                                }
                                            },
                                            "y": {
                                                "type": "object",
                                                "properties": {
                                                    "min": {
                                                        "type": "number"
                                                    },
                                                    "max": {
                                                        "type": "number"
                                                    }
                                                }
                                            },
                                            "z": {
                                                "type": "object",
                                                "properties": {
                                                    "min": {
                                                        "type": "number"
                                                    },
                                                    "max": {
                                                        "type": "number"
                                                    }
                                                }
                                            }
                                        }
                                    },
                                    "units": {
                                        "type": "string",
                                        "enum": [
                                            "MM",
                                            "CM",
                                            "FT",
                                            "IN"
                                        ]
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "description": "LINEAR_TOLERANCE value",
                                "required": [
                                    "planes",
                                    "nominal",
                                    "upperDeviation",
                                    "lowerDeviation",
                                    "units"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "Optional human-readable label, for example the drawing callout"
                                    },
                                    "planes": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "required": [
                                                "center",
                                                "normal",
                                                "xAxis",
                                                "width",
                                                "height",
                                                "fitOrientation",
                                                "searchDistance"
                                            ],
                                            "properties": {
                                                "center": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "number"
                                                    },
                                                    "minItems": 3,
                                                    "maxItems": 3,
                                                    "description": "The center of the rectangle [x, y, z], on the plane, in the model frame"
                                                },
                                                "normal": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "number"
                                                    },
                                                    "minItems": 3,
                                                    "maxItems": 3,
                                                    "description": "Unit normal of the plane [x, y, z], pointing out of the material"
                                                },
                                                "xAxis": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "number"
                                                    },
                                                    "minItems": 3,
                                                    "maxItems": 3,
                                                    "description": "Unit vector in the plane [x, y, z], perpendicular to normal: the direction of width"
                                                },
                                                "width": {
                                                    "type": "number",
                                                    "exclusiveMinimum": 0,
                                                    "description": "The size of the rectangle along xAxis"
                                                },
                                                "height": {
                                                    "type": "number",
                                                    "exclusiveMinimum": 0,
                                                    "description": "The size of the rectangle along normal × xAxis"
                                                },
                                                "fitOrientation": {
                                                    "type": "boolean",
                                                    "description": "true: the scan fits the orientation and the position of the plane. false: it fits only the position, and keeps the orientation of the model. Use false for a small plane, where a fitted orientation is not accurate"
                                                },
                                                "searchDistance": {
                                                    "type": "number",
                                                    "exclusiveMinimum": 0,
                                                    "description": "How far from the location in the model the scan searches for the plane, after it aligns the model to the scan. Too small, and a part with a large deviation has no match. Too large, and the scan can fit another surface nearby"
                                                }
                                            }
                                        },
                                        "minItems": 2,
                                        "maxItems": 2,
                                        "description": "The 2 feature planes [A, B]. Each is a bounded rectangle: the scan fits the plane only inside it, so other surfaces near the same plane are not measured"
                                    },
                                    "measureDirection": {
                                        "type": "array",
                                        "items": {
                                            "type": "number"
                                        },
                                        "minItems": 3,
                                        "maxItems": 3,
                                        "description": "Optional unit vector [x, y, z]: the direction to measure the distance along, for example an axis of the model frame. When absent, the normal of plane A"
                                    },
                                    "nominal": {
                                        "type": "number",
                                        "minimum": 0,
                                        "description": "Nominal distance between the 2 planes: |(B.center − A.center) · m|, with m the measureDirection, or the normal of plane A when it is absent"
                                    },
                                    "upperDeviation": {
                                        "type": "number",
                                        "description": "Upper deviation from nominal (signed). The largest allowed distance is nominal + upperDeviation"
                                    },
                                    "lowerDeviation": {
                                        "type": "number",
                                        "description": "Lower deviation from nominal (signed). The smallest allowed distance is nominal + lowerDeviation. Must not be greater than upperDeviation"
                                    },
                                    "units": {
                                        "type": "string",
                                        "enum": [
                                            "MM",
                                            "CM",
                                            "FT",
                                            "IN"
                                        ],
                                        "description": "Units of every length in this value. Use the units of the manifest entry"
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "description": "CIRCULARITY_TOLERANCE value",
                                "required": [
                                    "axis",
                                    "radius",
                                    "length",
                                    "tolerance",
                                    "fitOrientation",
                                    "searchDistance",
                                    "units"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "Optional human-readable label, for example the drawing callout"
                                    },
                                    "axis": {
                                        "type": "object",
                                        "required": [
                                            "point",
                                            "direction"
                                        ],
                                        "properties": {
                                            "point": {
                                                "type": "array",
                                                "items": {
                                                    "type": "number"
                                                },
                                                "minItems": 3,
                                                "maxItems": 3,
                                                "description": "The start of the cylinder on the axis [x, y, z], in the model frame: the center of the opening of the feature, where the scan sees the surface best"
                                            },
                                            "direction": {
                                                "type": "array",
                                                "items": {
                                                    "type": "number"
                                                },
                                                "minItems": 3,
                                                "maxItems": 3,
                                                "description": "Unit direction of the axis [x, y, z], from the opening into the feature"
                                            }
                                        }
                                    },
                                    "radius": {
                                        "type": "number",
                                        "exclusiveMinimum": 0,
                                        "description": "Nominal radius of the cylindrical feature"
                                    },
                                    "length": {
                                        "type": "number",
                                        "exclusiveMinimum": 0,
                                        "description": "The length of the cylinder along the axis, from axis.point in the direction of axis.direction"
                                    },
                                    "tolerance": {
                                        "type": "number",
                                        "exclusiveMinimum": 0,
                                        "description": "Width of the circularity tolerance zone: the radial distance between 2 concentric circles, in each cross-section perpendicular to the axis"
                                    },
                                    "fitOrientation": {
                                        "type": "boolean",
                                        "description": "true: the scan fits the orientation and the position of the cylinder. false: it fits only the position, and keeps the orientation of the model. Use false for a small cylinder, where a fitted orientation is not accurate"
                                    },
                                    "searchDistance": {
                                        "type": "number",
                                        "exclusiveMinimum": 0,
                                        "description": "How far from the location in the model the scan searches for the cylinder, after it aligns the model to the scan. Too small, and a part with a large deviation has no match. Too large, and the scan can fit another surface nearby"
                                    },
                                    "units": {
                                        "type": "string",
                                        "enum": [
                                            "MM",
                                            "CM",
                                            "FT",
                                            "IN"
                                        ],
                                        "description": "Units of every length in this value. Use the units of the manifest entry"
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        },
        "globalConstraints": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "type",
                    "value"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "MIN_PART_DISTANCE",
                            "VOLUME_BASED_SPACING"
                        ]
                    },
                    "value": {
                        "oneOf": [
                            {
                                "type": "object",
                                "description": "MIN_PART_DISTANCE value",
                                "required": [
                                    "distance",
                                    "units"
                                ],
                                "properties": {
                                    "distance": {
                                        "type": "number",
                                        "minimum": 0,
                                        "description": "Minimum distance between any two parts"
                                    },
                                    "units": {
                                        "type": "string",
                                        "enum": [
                                            "MM",
                                            "CM",
                                            "FT",
                                            "IN"
                                        ]
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "description": "VOLUME_BASED_SPACING value",
                                "required": [
                                    "smallParts",
                                    "largeParts"
                                ],
                                "properties": {
                                    "smallParts": {
                                        "type": "object",
                                        "required": [
                                            "maxVolume",
                                            "minSpacing",
                                            "units"
                                        ],
                                        "properties": {
                                            "maxVolume": {
                                                "type": "number",
                                                "minimum": 0,
                                                "description": "Maximum volume to be considered a small part (in cubic mm)"
                                            },
                                            "minSpacing": {
                                                "type": "number",
                                                "minimum": 0,
                                                "description": "Minimum spacing required between small parts"
                                            },
                                            "units": {
                                                "type": "string",
                                                "enum": [
                                                    "MM",
                                                    "CM",
                                                    "FT",
                                                    "IN"
                                                ]
                                            }
                                        }
                                    },
                                    "largeParts": {
                                        "type": "object",
                                        "required": [
                                            "minVolume",
                                            "minSpacing",
                                            "units"
                                        ],
                                        "properties": {
                                            "minVolume": {
                                                "type": "number",
                                                "minimum": 0,
                                                "description": "Minimum volume to be considered a large part (in cubic mm)"
                                            },
                                            "minSpacing": {
                                                "type": "number",
                                                "minimum": 0,
                                                "description": "Minimum spacing required between large parts"
                                            },
                                            "units": {
                                                "type": "string",
                                                "enum": [
                                                    "MM",
                                                    "CM",
                                                    "FT",
                                                    "IN"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        },
        "optimization": {
            "type": "object",
            "required": [
                "strategy",
                "weight"
            ],
            "properties": {
                "strategy": {
                    "type": "string",
                    "enum": [
                        "MINIMIZE_HEIGHT",
                        "MAXIMIZE_DENSITY",
                        "MINIMIZE_SUPPORT"
                    ],
                    "description": "Primary optimization strategy"
                },
                "weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Weight of optimization strategy (0-1)"
                }
            }
        }
    }
}
